---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const topics = getUniqueTags(posts).slice(0, 8);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-10 pb-8">
      <p class="text-accent mb-2 text-sm font-semibold tracking-widest uppercase">
        Digital Skills Hub
      </p>
      <h1 class="text-3xl leading-tight font-bold sm:text-5xl">
        Learn digital skills. Build an online income, honestly.
      </h1>
      <p class="text-muted-foreground mt-4 max-w-xl text-lg">
        Practical, beginner-friendly guides on free tools, freelancing, and
        digital products, with realistic expectations and no hype.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="bg-accent text-accent-foreground rounded-lg px-5 py-2.5 font-semibold hover:opacity-90"
        >
          Read the guides
        </a>
        <a
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="inline-flex items-center gap-1 px-2 py-2.5"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss width={20} height={20} class="stroke-accent stroke-3 rtl:-rotate-90" />
          <span class="text-sm">RSS</span>
        </a>
      </div>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      topics.length > 0 && (
        <section id="topics" class="border-border border-b py-6">
          <h2 class="text-muted-foreground mb-3 text-sm font-semibold tracking-widest uppercase">
            Browse by topic
          </h2>
          <ul class="flex flex-wrap gap-2">
            {topics.map(({ tag, tagName }) => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
                  class="border-border bg-muted hover:border-accent hover:text-accent inline-block rounded-full border px-3 py-1 text-sm font-medium"
                >
                  {tagName}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-10 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Start here</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {featuredPosts.slice(0, 4).map(post => (
              <li class="border-border bg-muted/40 hover:border-accent rounded-xl border p-5 transition-colors">
                <a
                  href={getPostUrl(post.id, post.filePath, Astro.currentLocale)}
                  class="block"
                >
                  <h3 class="text-accent text-lg leading-snug font-semibold">
                    {post.data.title}
                  </h3>
                  <p class="text-muted-foreground mt-2 text-sm">
                    {post.data.description}
                  </p>
                  <span class="text-accent mt-3 inline-block text-sm font-medium">
                    Read the guide &rarr;
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <section id="how-we-work" class="border-border bg-muted/40 my-8 rounded-xl border p-6">
      <h2 class="text-xl font-semibold">How we work</h2>
      <ul class="text-muted-foreground mt-3 list-disc space-y-1 ps-5">
        <li>Beginner-friendly explanations, step by step.</li>
        <li>Realistic expectations. Income examples are illustrative, never promises.</li>
        <li>Every article is reviewed and edited by a person before publishing.</li>
      </ul>
      <p class="mt-3 text-sm">
        <a class="text-accent underline underline-offset-4" href="/about">About us</a>
        &middot;
        <a class="text-accent underline underline-offset-4" href="/disclaimer">Disclaimer</a>
      </p>
    </section>

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
