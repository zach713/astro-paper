---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class={`${noMarginTop ? "" : "mt-auto"} w-full`} {...attrs}>
  <div class="flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4">
    <Socials />
    <div class="my-2 flex flex-col items-center gap-2 sm:flex-row sm:gap-4 text-sm opacity-80">
      <span>&#169; {currentYear} Digital Skills Hub</span>
      <div class="flex gap-3">
        <a href="/about" class="hover:underline hover:text-accent">About</a>
        <span>&#8226;</span>
        <a href="/contact" class="hover:underline hover:text-accent">Contact</a>
        <span>&#8226;</span>
        <a href="/privacy" class="hover:underline hover:text-accent">Privacy</a>
        <span>&#8226;</span>
        <a href="/disclaimer" class="hover:underline hover:text-accent">Disclaimer</a>
      </div>
    </div>
  </div>
</footer>
